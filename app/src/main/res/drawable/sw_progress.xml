<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing's song position: a cyan bar in a dark slot -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background"><shape><solid android:color="#FF0A1508" /><stroke android:width="1dp" android:color="#FF5D6B45" /></shape></item>
    <item android:id="@android:id/progress" android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <clip><shape><solid android:color="#FF2DE2E6" /></shape></clip></item>
</layer-list>
