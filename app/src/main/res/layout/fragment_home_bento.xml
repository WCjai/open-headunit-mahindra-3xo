<?xml version="1.0" encoding="utf-8"?>
<!--
    The synthwave home (ui/Head Unit UI Mock.html, "Home"): glass cards over a sunset coast.

    Top bar: the menu (Android Settings, Head Unit Settings, Bluetooth, Apple CarPlay), the time and
    date, and Bluetooth and Wi-Fi badges. Four columns under it: Now Playing, Android Auto, Apple
    CarPlay, and More Apps over Radio.

    The Android Auto card is view_tv_aa_card, which carries view_home_primary_card's ids, so
    HomeFragment's connection logic, countdown and status keep driving it unchanged. The CarPlay card
    is view_sw_carplay_card (CarPlayHomeCard). BentoHomeController binds the rest.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bento_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.andrerinas.openheadunit.main.synthwave.SynthwaveBackdropView
        android:id="@+id/bento_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/bento_top_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/bento_menu_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:background="?attr/uiMenuBtnBg"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/tv_menu"
            app:srcCompat="@drawable/sw_ic_menu" />

        <TextView
            android:id="@+id/bento_clock"
            style="@style/SwText.Clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:includeFontPadding="false"
            android:textColor="@color/tv_white"
            android:textSize="36sp" />

        <View
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_marginLeft="12dp"
            android:background="?attr/uiStatusDot" />

        <TextView
            android:id="@+id/bento_date"
            style="@style/SwText"
            android:layout_marginLeft="12dp"
            android:fontFamily="?attr/uiFontDigitsBold"
            android:textAllCaps="?attr/uiCaps"
            android:textColor="?attr/uiTextDate"
            android:textSize="18sp"
            android:shadowColor="?attr/uiShadow"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="1" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/bento_status_bt"
            style="@style/SwBadge"
            app:srcCompat="@drawable/sw_ic_bluetooth" />

        <ImageView
            android:id="@+id/bento_status_wifi"
            style="@style/SwBadge"
            android:layout_marginLeft="8dp"
            app:srcCompat="@drawable/sw_ic_wifi" />

    </LinearLayout>

    <!-- The four columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginTop="76dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Now Playing: Android Auto's song while projecting, else the car's radio or Bluetooth audio -->
        <LinearLayout
            android:id="@+id/bento_music_card"
            style="@style/SwCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:foreground="?attr/uiCardPress"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout style="@style/SwCardHeader">

                <TextView
                    style="@style/SwText.Header"
                    android:text="@string/tv_now_playing" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:id="@+id/bento_music_chip"
                    style="@style/SwChip">

                    <ImageView
                        android:id="@+id/bento_music_source_icon"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="3dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_bluetooth"
                        app:tint="?attr/uiTextSoft" />

                    <TextView
                        android:id="@+id/bento_music_source"
                        style="@style/SwText.Chip" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bento_music_scope"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:layout_width="104dp"
                    android:layout_height="104dp">

                    <ImageView
                        android:id="@+id/bento_music_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/uiAlbumBg"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/bento_music_art_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_music"
                        app:tint="?attr/uiAccent" />

                </FrameLayout>

                <TextView
                    android:id="@+id/bento_music_title"
                    style="@style/SwText.Big"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:requiresFadingEdge="horizontal"
                    android:fadingEdgeLength="16dp"
                    android:includeFontPadding="false"
                    android:textColor="?attr/uiHighlight"
                    android:textSize="28sp"
                    android:shadowDx="2"
                    android:shadowDy="2" />

                <TextView
                    android:id="@+id/bento_music_artist"
                    style="@style/SwText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/bento_music_state"
                    style="@style/SwText.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="6dp"
                    android:background="?attr/uiChipAccentBg"
                    android:includeFontPadding="false"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:textColor="?attr/uiAccent"
                    android:visibility="gone" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- Android Auto only: the phone reports where the song is -->
                <LinearLayout
                    android:id="@+id/bento_music_progress_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/bento_music_progress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="1000"
                        android:progressDrawable="?attr/uiProgress" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/bento_music_elapsed"
                            style="@style/SwText"
                            android:fontFamily="?attr/uiFontDigitsBold"
                            android:textColor="?attr/uiTextIce"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/bento_music_remaining"
                            style="@style/SwText"
                            android:fontFamily="?attr/uiFontDigitsBold"
                            android:textColor="?attr/uiTextIce"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bento_music_controls"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/bento_music_prev"
                    style="@style/SwButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="8dp"
                    android:contentDescription="@string/tv_previous">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:duplicateParentState="true"
                        app:srcCompat="@drawable/sw_ic_prev" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/bento_music_play"
                    style="@style/SwButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.4"
                    android:contentDescription="@string/tv_play_pause">
                    <ImageView
                        android:id="@+id/bento_music_play_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_pause"
                        app:tint="?attr/uiHighlight" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/bento_music_next"
                    style="@style/SwButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/tv_next">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:duplicateParentState="true"
                        app:srcCompat="@drawable/sw_ic_next" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Android Auto: HomeFragment's own connection card -->
        <include
            layout="@layout/view_tv_aa_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.84"
            android:layout_marginLeft="14dp" />

        <!-- Apple CarPlay -->
        <include
            layout="@layout/view_sw_carplay_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.84"
            android:layout_marginLeft="14dp" />

        <!-- More Apps over Radio -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.84"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/bento_tile_more"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="?attr/uiCardBg"
                android:foreground="?attr/uiCardPress"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/sw_more_apps_hint">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical">

                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <View android:layout_width="34dp" android:layout_height="34dp" android:background="?attr/uiDotTile" />
                        <View android:layout_width="34dp" android:layout_height="34dp" android:layout_marginLeft="8dp" android:background="?attr/uiDotTile" />
                        <View android:layout_width="34dp" android:layout_height="34dp" android:layout_marginLeft="8dp" android:background="?attr/uiDotTile" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <View android:layout_width="34dp" android:layout_height="34dp" android:background="?attr/uiDotTile" />
                        <View android:layout_width="34dp" android:layout_height="34dp" android:layout_marginLeft="8dp" android:background="?attr/uiDotTile" />
                        <View android:layout_width="34dp" android:layout_height="34dp" android:layout_marginLeft="8dp" android:background="?attr/uiDotTile" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <View android:layout_width="34dp" android:layout_height="34dp" android:background="?attr/uiDotTile" />
                        <View android:layout_width="34dp" android:layout_height="34dp" android:layout_marginLeft="8dp" android:background="?attr/uiDotTile" />
                        <View android:layout_width="34dp" android:layout_height="34dp" android:layout_marginLeft="8dp" android:background="?attr/uiDotTile" />
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <LinearLayout
                android:id="@+id/bento_tile_radio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:background="?attr/uiCardAltBg"
                android:foreground="?attr/uiCardPress"
                android:padding="10dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/tv_radio">

                <LinearLayout style="@style/SwCardHeader">
                    <TextView
                        style="@style/SwText.Header"
                        android:text="@string/tv_radio" />
                </LinearLayout>

                <com.andrerinas.openheadunit.main.synthwave.TunerScaleView
                    android:id="@+id/bento_radio_scale"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="6dp"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/bento_radio_am"
                            style="@style/SwText.Big"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/sw_am_label"
                            android:textColor="?attr/uiHighlight"
                            android:textSize="22sp" />

                        <View
                            android:layout_width="36dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="2dp"
                            android:background="?attr/uiHighlight" />

                        <TextView
                            android:id="@+id/bento_radio_fm"
                            style="@style/SwText.Big"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/sw_fm_label"
                            android:textColor="?attr/uiHighlight"
                            android:textSize="22sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.andrerinas.openheadunit.main.synthwave.TuningKnobView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:importantForAccessibility="no" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/bento_radio_level"
                        android:layout_width="58dp"
                        android:layout_height="30dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="?attr/uiWaveform" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- HomeFragment holds these as lateinit fields and its painters look them up. This home does
         not show them; the cards and the menu do their jobs. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <LinearLayout android:id="@+id/usb_button" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/wifi_button" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/self_mode_button" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/settings_button" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/exit_button" android:layout_width="0dp" android:layout_height="0dp" />
        <LinearLayout android:id="@+id/apps_button" android:layout_width="0dp" android:layout_height="0dp" />
    </LinearLayout>

    <!-- The menu: a tap outside closes it -->
    <FrameLayout
        android:id="@+id/bento_menu_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/bento_menu"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="66dp"
            android:orientation="vertical"
            android:background="?attr/uiMenuBg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:elevation="16dp">

            <LinearLayout
                android:id="@+id/bento_menu_android_settings"
                style="@style/TvMenuItem">
                <ImageView
                    style="@style/TvMenuIcon"
                    app:srcCompat="@drawable/sw_ic_settings"
                    app:tint="?attr/uiAccent" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/TvMenuTitle" android:text="@string/tv_menu_android_settings" />
                    <TextView style="@style/TvMenuSubtitle" android:text="@string/tv_menu_android_settings_detail" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:background="?attr/uiDivider" />

            <LinearLayout
                android:id="@+id/bento_menu_headunit_settings"
                style="@style/TvMenuItem">
                <ImageView
                    style="@style/TvMenuIcon"
                    app:srcCompat="@drawable/sw_ic_eq"
                    app:tint="?attr/uiHighlight" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/TvMenuTitle" android:text="@string/tv_menu_headunit_settings" />
                    <TextView style="@style/TvMenuSubtitle" android:text="@string/tv_menu_headunit_settings_detail" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginLeft="18dp"
                android:layout_marginRight="18dp"
                android:background="?attr/uiDivider" />

            <LinearLayout
                android:id="@+id/bento_menu_bluetooth"
                style="@style/TvMenuItem">
                <ImageView
                    style="@style/TvMenuIcon"
                    app:srcCompat="@drawable/sw_ic_bluetooth"
                    app:tint="?attr/uiAccent" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/TvMenuTitle" android:text="@string/tv_menu_bluetooth" />
                    <TextView style="@style/TvMenuSubtitle" android:text="@string/tv_menu_bluetooth_detail" />
                </LinearLayout>
            </LinearLayout>

            <!-- Apple CarPlay settings are on their own tab of Head Unit Settings, not here -->

        </LinearLayout>

    </FrameLayout>

    <!-- A call on the car's Bluetooth: shown over the home, answered or ended here -->
    <FrameLayout
        android:id="@+id/bento_call_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:visibility="gone">

        <com.andrerinas.openheadunit.main.synthwave.SynthwaveBackdropView
            android:id="@+id/bento_call_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/uiScrim" />

        <LinearLayout
            android:id="@+id/bento_call_card"
            style="@style/SwCard"
            android:layout_width="760dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:layout_marginTop="31dp"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:paddingTop="16dp"
            android:paddingBottom="18dp">

            <LinearLayout style="@style/SwCardHeader">

                <TextView
                    android:id="@+id/bento_call_state"
                    style="@style/SwText.Header" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout style="@style/SwChip">
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginRight="3dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_bluetooth"
                        app:tint="?attr/uiTextSoft" />
                    <TextView
                        style="@style/SwText.Chip"
                        android:text="@string/tv_source_bt" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/bento_call_scope"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="20dp"
                android:paddingRight="28dp">

                <FrameLayout
                    android:layout_width="136dp"
                    android:layout_height="136dp">

                    <View
                        android:id="@+id/bento_call_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/uiAvatarRing" />

                    <TextView
                        android:id="@+id/bento_call_avatar"
                        style="@style/SwText.Big"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="?attr/uiAvatarBg"
                        android:includeFontPadding="false"
                        android:textColor="@color/tv_white"
                        android:textSize="52sp"
                        android:shadowDx="2"
                        android:shadowDy="2"
                        android:importantForAccessibility="no" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="22dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/bento_call_name"
                        style="@style/SwText.Big"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false"
                        android:textColor="@color/tv_white"
                        android:textSize="52sp"
                        android:shadowDx="2"
                        android:shadowDy="2" />

                    <TextView
                        android:id="@+id/bento_call_number"
                        style="@style/SwText"
                        android:layout_width="match_parent"
                        android:layout_marginTop="6dp"
                        android:fontFamily="?attr/uiFontDigitsBold"
                        android:textColor="?attr/uiTextIce"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/bento_call_chip"
                        style="@style/SwText.Chip"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_marginTop="6dp"
                        android:background="?attr/uiChipAccentBg"
                        android:includeFontPadding="false"
                        android:paddingLeft="6dp"
                        android:paddingRight="6dp"
                        android:textColor="?attr/uiAccent" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/bento_call_hangup"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="?attr/uiDeclineBg"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/bento_hang_up">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_phone_down" />
                    <TextView
                        android:id="@+id/bento_call_hangup_label"
                        style="@style/SwText.Big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/tv_white"
                        android:textSize="24sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bento_call_answer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="12dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="?attr/uiAnswerBg"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/bento_answer">
                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_phone" />
                    <TextView
                        style="@style/SwText.Big"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:includeFontPadding="false"
                        android:text="@string/sw_answer"
                        android:textColor="@color/tv_white"
                        android:textSize="24sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
