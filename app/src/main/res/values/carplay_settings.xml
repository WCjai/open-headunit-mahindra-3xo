    <string name="cp_frame_rate">Frame rate</string>
    <string name="cp_frame_rate_value">%1$d fps</string>
    <string name="cp_hide_bars">Hide the system bars</string>
    <string name="cp_hide_bars_desc">Hides the unit\'s status and navigation bars over CarPlay.</string>
    <string name="cp_corners">Rounded corners</string>
    <string name="cp_corners_off">Off</string>
    <string name="cp_corners_value">%1$d dp</string>
    <string name="cp_hevc">Efficient video (HEVC)</string>
    <string name="cp_hevc_desc">Uses HEVC instead of H.264. Leave off unless the picture needs it.</string>
    <string name="cp_smooth">Smooth video (experimental)</string>
    <string name="cp_smooth_desc">Shows frames at an even pace. Scrolling can look smoother, but touches respond a little later.</string>
    <string name="cp_low_latency">Low-latency decoding (experimental)</string>
    <string name="cp_low_latency_desc">Shows each frame as soon as it is decoded. Turn it off if the picture breaks up or freezes.</string>

    <string name="cp_nav_volume">Navigation voice volume</string>
    <string name="cp_nav_volume_full">Full</string>
    <string name="cp_nav_volume_value">%1$d dB</string>
    <string name="cp_music_buffer">Music buffer</string>
    <string name="cp_music_buffer_value">%1$d ms</string>
    <string name="cp_audio_focus">Audio focus</string>
    <string name="cp_audio_focus_desc">CarPlay music takes the car\'s audio focus. Turn it off if sound goes missing.</string>
    <string name="cp_buffered_music">Buffered music (experimental)</string>
    <string name="cp_buffered_music_desc">Apps that support it, such as Apple Music, send music ahead so short gaps are not heard.</string>
    <string name="cp_drop_bluetooth">Disconnect the car\'s Bluetooth during CarPlay</string>
    <string name="cp_drop_bluetooth_desc">When the iPhone asks, the car\'s Bluetooth lets go of it while CarPlay runs, so calls come through CarPlay and the caller is heard. It reconnects when CarPlay ends. Off: the iPhone stays on the car\'s Bluetooth, and a call is only heard if you pick Bluetooth for its audio on the iPhone.</string>
    <string name="cp_echo">Call echo cancellation (experimental)</string>
    <string name="cp_echo_desc">Tries to reduce speaker echo the other person hears during CarPlay calls.</string>
    <string name="cp_voice">Clearer call voices (experimental)</string>
    <string name="cp_voice_desc">Cuts bass from CarPlay call audio.</string>

    <string name="cp_fps_counter">Frame counter</string>
    <string name="cp_fps_counter_desc">Shows frames per second in a corner of CarPlay.</string>
    <string name="cp_debug_logs">Detailed CarPlay logs</string>
    <string name="cp_debug_logs_desc">Writes more detail to the CarPlay log, for a report.</string>
    <string name="cp_report">Save a CarPlay report</string>
    <string name="cp_report_desc">CarPlay\'s state, settings and recent log, saved to Downloads/OpenHeadunit.</string>
    <string name="cp_report_saving">Saving the CarPlay report…</string>
    <string name="cp_report_saved">CarPlay report saved: %1$s</string>
    <string name="cp_report_failed">The CarPlay report could not be saved: %1$s</string>
