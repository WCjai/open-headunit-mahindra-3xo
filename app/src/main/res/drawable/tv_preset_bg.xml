<?xml version="1.0" encoding="utf-8"?>
<!-- A saved station: glass, lit up while it is the one playing. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/tv_glass_btn_pressed" /><stroke android:width="1dp" android:color="@color/tv_glass_btn_edge" /><corners android:radius="18dp" /></shape></item>
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="#42FFFFFF" /><stroke android:width="2dp" android:color="#9EFFFFFF" /><corners android:radius="18dp" /></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/tv_glass_btn_pressed" /><stroke android:width="2dp" android:color="@color/tv_white_70" /><corners android:radius="18dp" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/tv_glass_btn" /><stroke android:width="1dp" android:color="@color/tv_glass_btn_edge" /><corners android:radius="18dp" /></shape></item>
</selector>
