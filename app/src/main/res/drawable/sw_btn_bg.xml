<?xml version="1.0" encoding="utf-8"?>
<!-- Glass button. Selected (the band in use, the playing station, play) has a pink edge and glow. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:radius="6dp" />
        <gradient android:angle="270" android:startColor="#52FFFFFF" android:endColor="#1FFFFFFF" />
        <stroke android:width="1.5dp" android:color="#FFFFAAD7" /></shape></item>
    <item android:state_selected="true"><layer-list>
        <item><shape><corners android:radius="7dp" /><stroke android:width="4dp" android:color="#33FF5FA2" /></shape></item>
        <item><shape><corners android:radius="6dp" />
        <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#1AFF5FA2" />
        <stroke android:width="1.5dp" android:color="#FFFF5FA2" /></shape></item>
    </layer-list></item>
    <item android:state_focused="true"><shape><corners android:radius="6dp" />
        <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#0FFFFFFF" />
        <stroke android:width="2dp" android:color="#FF2DE2E6" /></shape></item>
    <item><shape><corners android:radius="6dp" />
        <gradient android:angle="270" android:startColor="#38FFFFFF" android:endColor="#0FFFFFFF" />
        <stroke android:width="1.5dp" android:color="#CCFFAAD7" /></shape></item>
</selector>
