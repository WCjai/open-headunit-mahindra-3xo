    <string name="cp_night_follow_android">Follow the car</string>
    <string name="cp_night_light_sensor">Follow the light sensor</string>
    <string name="cp_night_day">Always day</string>
    <string name="cp_night_night">Always night</string>
    <string name="cp_size">Icon size</string>
