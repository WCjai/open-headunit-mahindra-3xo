    <string name="cp_info_next_connection">Changes apply the next time the iPhone connects. Unplug it and plug it back in to apply them now.</string>
    <string name="cp_info_no_identity">This build has no CarPlay identity, so an iPhone cannot start CarPlay. See carplay/README.md.</string>
    <string name="cp_how_to_connect">How to connect</string>
    <string name="cp_how_to_connect_value">Plug the iPhone into the unit with its cable. CarPlay opens by itself; the first time, allow USB access and the VPN, and tap Trust on the iPhone.</string>

    <string name="cp_right_hand_drive">Right-hand drive</string>
    <string name="cp_right_hand_drive_desc">Puts CarPlay\'s controls closer to the driver.</string>
