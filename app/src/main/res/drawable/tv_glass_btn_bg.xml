<?xml version="1.0" encoding="utf-8"?>
<!-- Glass button: white at 10%, brighter pressed or focused, solid white when selected. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="rectangle"><solid android:color="@color/tv_glass_btn_pressed" /><stroke android:width="1dp" android:color="@color/tv_glass_btn_edge" /><corners android:radius="@dimen/tv_btn_radius" /></shape></item>
    <item android:state_selected="true"><shape android:shape="rectangle"><solid android:color="@color/tv_white" /><corners android:radius="@dimen/tv_btn_radius" /></shape></item>
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/tv_glass_btn_pressed" /><stroke android:width="2dp" android:color="@color/tv_white_70" /><corners android:radius="@dimen/tv_btn_radius" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/tv_glass_btn" /><stroke android:width="1dp" android:color="@color/tv_glass_btn_edge" /><corners android:radius="@dimen/tv_btn_radius" /></shape></item>
</selector>
