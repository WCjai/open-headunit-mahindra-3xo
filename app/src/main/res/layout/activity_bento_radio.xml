<?xml version="1.0" encoding="utf-8"?>
<!--
    The car's radio in the synthwave style (ui/Head Unit UI Mock.html, "Radio").

    Tuner: the band and power in its header; seek down, the frequency in big pink figures and seek up;
    the printed scale (drag along it to tune); FM, AM and Scan under it. Presets: six stations a page
    (three pages per band), tap to tune, hold to store the playing frequency there.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.andrerinas.openheadunit.main.synthwave.SynthwaveBackdropView
        android:id="@+id/sw_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <include layout="@layout/view_sw_screen_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="18dp"
        android:layout_marginRight="18dp"
        android:layout_marginTop="76dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Tuner -->
        <LinearLayout
            android:id="@+id/radio_tuner_card"
            style="@style/SwCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.45">

            <LinearLayout style="@style/SwCardHeader">

                <TextView
                    style="@style/SwText.Header"
                    android:text="@string/sw_tuner" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/radio_kicker"
                    style="@style/SwText.Chip"
                    android:layout_height="22dp"
                    android:background="?attr/uiChipBg"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp" />

                <FrameLayout
                    android:id="@+id/radio_power"
                    style="@style/SwButton"
                    android:layout_width="40dp"
                    android:layout_height="30dp"
                    android:layout_marginLeft="8dp"
                    android:contentDescription="@string/tv_radio_power">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_power" />
                </FrameLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/radio_tuner"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:paddingLeft="18dp"
                android:paddingRight="18dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <FrameLayout
                        android:id="@+id/radio_seek_down"
                        style="@style/SwButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/bento_radio_seek_down">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/sw_ic_seek_back" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="22dp"
                        android:layout_marginRight="22dp"
                        android:minWidth="260dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <TextView
                            android:id="@+id/radio_frequency"
                            style="@style/SwText.Clock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:textColor="?attr/uiHighlight"
                            android:textSize="92sp"
                            android:shadowColor="?attr/uiHighlightGlow"
                            android:shadowDx="0"
                            android:shadowDy="0"
                            android:shadowRadius="22" />

                        <TextView
                            android:id="@+id/radio_unit"
                            style="@style/SwText.Label"
                            android:layout_marginTop="2dp"
                            android:letterSpacing="0.2"
                            android:textAllCaps="?attr/uiCaps"
                            android:textColor="?attr/uiTextIce"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/radio_station"
                            style="@style/SwText.Label"
                            android:layout_width="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxWidth="300dp"
                            android:ellipsize="end"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/radio_text"
                            style="@style/SwText.Label"
                            android:layout_width="300dp"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:ellipsize="marquee"
                            android:marqueeRepeatLimit="marquee_forever"
                            android:singleLine="true"
                            android:textColor="?attr/uiTextIce"
                            android:textSize="12sp"
                            android:visibility="invisible" />

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/radio_seek_up"
                        style="@style/SwButton"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="@string/bento_radio_seek_up">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            app:srcCompat="@drawable/sw_ic_seek_fwd" />
                    </FrameLayout>

                </LinearLayout>

                <com.andrerinas.openheadunit.main.synthwave.TunerScaleView
                    android:id="@+id/radio_dial"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/radio_band_fm"
                    style="@style/SwButton.Text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="?attr/uiBtnBg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/sw_fm_label" />

                <TextView
                    android:id="@+id/radio_band_am"
                    style="@style/SwButton.Text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="8dp"
                    android:background="?attr/uiBtnBg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/sw_am_label" />

                <TextView
                    android:id="@+id/radio_scan"
                    style="@style/SwButton.Text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.6"
                    android:layout_marginLeft="8dp"
                    android:background="?attr/uiBtnBg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

        <!-- Presets -->
        <LinearLayout
            android:id="@+id/radio_presets_card"
            style="@style/SwCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="14dp">

            <LinearLayout style="@style/SwCardHeader">

                <TextView
                    style="@style/SwText.Header"
                    android:text="@string/sw_presets" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/radio_page_prev"
                    style="@style/SwButton"
                    android:layout_width="30dp"
                    android:layout_height="28dp"
                    android:contentDescription="@string/bento_radio_page_prev">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_chevron_left" />
                </FrameLayout>

                <TextView
                    android:id="@+id/radio_page"
                    style="@style/SwText.Label"
                    android:layout_width="42dp"
                    android:gravity="center"
                    android:textSize="13sp" />

                <FrameLayout
                    android:id="@+id/radio_page_next"
                    style="@style/SwButton"
                    android:layout_width="30dp"
                    android:layout_height="28dp"
                    android:layout_marginRight="10dp"
                    android:contentDescription="@string/bento_radio_page_next">
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:rotation="180"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_chevron_left" />
                </FrameLayout>

                <TextView
                    style="@style/SwText.Chip"
                    android:layout_height="22dp"
                    android:background="?attr/uiChipBg"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="@string/sw_hold_to_save" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/radio_presets"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
