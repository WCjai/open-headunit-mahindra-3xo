<?xml version="1.0" encoding="utf-8"?>
<!-- The Android Auto card while a phone is connected: the glass card with a green wash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_glass" />
            <stroke android:width="1dp" android:color="@color/tv_glass_edge" />
            <corners android:radius="@dimen/tv_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#294ADE80" android:endColor="#00FFFFFF" />
            <corners android:radius="@dimen/tv_card_radius" />
        </shape>
    </item>
</layer-list>
