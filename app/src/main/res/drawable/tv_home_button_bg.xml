<?xml version="1.0" encoding="utf-8"?>
<!-- The Home button floating over Android Auto and CarPlay: a dark glass disc with a light edge -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape android:shape="oval"><solid android:color="#59FFFFFF" /><stroke android:width="1dp" android:color="#66FFFFFF" /></shape></item>
    <item><shape android:shape="oval"><solid android:color="#8C14141E" /><stroke android:width="1dp" android:color="#38FFFFFF" /></shape></item>
</selector>
