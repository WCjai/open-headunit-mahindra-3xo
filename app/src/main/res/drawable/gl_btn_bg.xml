<?xml version="1.0" encoding="utf-8"?>
<!-- Glass button. Selected (the band in use, the playing station) is a brighter pane with a white edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:radius="12dp" /><solid android:color="#40FFFFFF" /><stroke android:width="1dp" android:color="#4DFFFFFF" /></shape></item>
    <item android:state_selected="true"><shape><corners android:radius="12dp" /><solid android:color="#42FFFFFF" /><stroke android:width="2dp" android:color="#CCFFFFFF" /></shape></item>
    <item android:state_focused="true"><shape><corners android:radius="12dp" /><solid android:color="#40FFFFFF" /><stroke android:width="2dp" android:color="#B3FFFFFF" /></shape></item>
    <item><shape><corners android:radius="12dp" /><solid android:color="#1FFFFFFF" /><stroke android:width="1dp" android:color="#29FFFFFF" /></shape></item>
</selector>
