<?xml version="1.0" encoding="utf-8"?>
<!-- Bento home (fragment_home_bento): frosted-glass tiles over the wallpaper, large rounded
     corners and calm white type, after Apple's TV home screen. Dark-only: it lives in a car. -->
<resources>
    <color name="bento_text">#FFFFFFFF</color>
    <color name="bento_text_secondary">#B3FFFFFF</color>
    <color name="bento_text_tertiary">#80FFFFFF</color>
    <color name="bento_glass">#1FFFFFFF</color>
    <color name="bento_glass_pressed">#33FFFFFF</color>
    <color name="bento_glass_strong">#4DFFFFFF</color>
    <color name="bento_glass_edge">#29FFFFFF</color>
    <color name="bento_play_icon">#FF0E1018</color>
    <color name="bento_answer">#FF2BB673</color>
    <color name="bento_answer_pressed">#FF1F8A57</color>
    <color name="bento_hangup">#FFE5484D</color>
    <color name="bento_hangup_pressed">#FFB3363A</color>
    <color name="bento_call_surface">#E61A1D27</color>
    <color name="bento_scrim">#66000000</color>

    <dimen name="bento_pad">14dp</dimen>
    <dimen name="bento_gap">12dp</dimen>
    <dimen name="bento_radius">22dp</dimen>
    <dimen name="bento_tile_icon">40dp</dimen>
    <dimen name="bento_media_button">52dp</dimen>
    <dimen name="bento_play_button">64dp</dimen>
    <dimen name="bento_call_button">64dp</dimen>

    <style name="BentoTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bento_card_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="BentoTileIcon">
        <item name="android:layout_width">@dimen/bento_tile_icon</item>
        <item name="android:layout_height">@dimen/bento_tile_icon</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="BentoTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textColor">@color/bento_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BentoKicker">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bento_text_tertiary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BentoMediaButton">
        <item name="android:layout_width">@dimen/bento_media_button</item>
        <item name="android:layout_height">@dimen/bento_media_button</item>
        <item name="android:background">@drawable/bento_round_button_bg</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <string name="bento_more_apps">More apps</string>
    <string name="bento_settings">Settings</string>
    <string name="bento_bluetooth">Bluetooth</string>
    <string name="bento_radio">Radio</string>
    <string name="bento_app_settings">Open Headunit settings</string>
    <string name="bento_source_android_auto">Android Auto</string>
    <string name="bento_source_bluetooth">Bluetooth audio</string>
    <string name="bento_nothing_playing">Nothing playing</string>
    <string name="bento_connect_to_play">Connect your phone by USB or Bluetooth</string>
    <string name="bento_unknown_artist">Unknown artist</string>
    <string name="bento_status_bluetooth_on">Phone on Bluetooth</string>
    <string name="bento_status_bluetooth_off">No phone on Bluetooth</string>
    <string name="bento_status_projecting">Android Auto connected</string>
    <string name="bento_call_incoming">Incoming call</string>
    <string name="bento_call_active">On a call</string>
    <string name="bento_call_outgoing">Calling…</string>
    <string name="bento_call_unknown_caller">Unknown caller</string>
    <string name="bento_answer">Answer</string>
    <string name="bento_hang_up">Hang up</string>
    <string name="bento_previous">Previous</string>
    <string name="bento_play_pause">Play or pause</string>
    <string name="bento_next">Next</string>
    <string name="bento_app_missing">%1$s is not installed on this head unit</string>
    <string name="home_layout_bento">Simple home (bento)</string>
    <string name="home_layout_bento_description">A calm home screen with music, Android Auto, Settings, Bluetooth and Radio. Other apps are under More apps.</string>
    <style name="BentoRowTile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bento_card_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <style name="BentoRowTileTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/bento_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BentoRowTileSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/bento_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="BentoSegment">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:background">@drawable/bento_segment_bg</item>
        <item name="android:textColor">@color/bento_segment_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Bluetooth screen -->
    <string name="bento_bt_title">Bluetooth</string>
    <string name="bento_bt_phone">Phone</string>
    <string name="bento_bt_connected">Connected</string>
    <string name="bento_bt_not_connected">No phone connected</string>
    <string name="bento_bt_connected_detail">Calls and music from your phone play through the car.</string>
    <string name="bento_bt_not_connected_detail">Turn on Bluetooth on your phone, or pair a new one.</string>
    <string name="bento_bt_unavailable">This head unit has no TopWay Bluetooth app.</string>
    <string name="bento_bt_disconnect">Disconnect</string>
    <string name="bento_bt_car_name">Car: %1$s</string>
    <string name="bento_bt_car_name_pin">Car: %1$s · PIN %2$s</string>
    <string name="bento_bt_pair">Pair or forget phones</string>
    <string name="bento_bt_pair_detail">Search, pair, connect and remove phones</string>
    <string name="bento_bt_phonebook">Phonebook</string>
    <string name="bento_bt_phonebook_count">%1$d numbers for caller names</string>
    <string name="bento_bt_phonebook_empty">Download contacts to see caller names</string>
    <string name="bento_bt_settings">Car name and PIN</string>
    <string name="bento_bt_settings_detail">How this car appears to phones</string>
    <string name="bento_bt_now_playing">Bluetooth audio</string>
    <string name="bento_bt_play_in_car">Play phone audio in the car</string>
    <string name="bento_bt_music_off">Connect a phone to play its music here</string>

    <!-- Radio screen -->
    <string name="bento_radio_title">Radio</string>
    <string name="bento_radio_fm">FM</string>
    <string name="bento_radio_am">AM</string>
    <string name="bento_radio_af">AF</string>
    <string name="bento_radio_ta">TA</string>
    <string name="bento_radio_scan">Scan</string>
    <string name="bento_radio_scanning">Scanning…</string>
    <string name="bento_radio_presets">Stations</string>
    <string name="bento_radio_preset_empty">Hold to save</string>
    <string name="bento_radio_saved">Saved %1$s %2$s</string>
    <string name="bento_radio_frequency">%1$s %2$s</string>
    <string name="bento_radio_seek_down">Seek down</string>
    <string name="bento_radio_seek_up">Seek up</string>
    <string name="bento_radio_step_down">Tune down</string>
    <string name="bento_radio_step_up">Tune up</string>
    <string name="bento_radio_page">%1$d / %2$d</string>
    <string name="bento_radio_unavailable">The car\'s tuner is not answering.</string>
