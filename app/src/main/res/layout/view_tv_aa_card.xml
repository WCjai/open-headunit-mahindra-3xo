<?xml version="1.0" encoding="utf-8"?>
<!--
    The home's Android Auto card in the synthwave style (ui/Head Unit UI Mock.html). It keeps every id
    of view_home_primary_card, so HomeFragment's connection logic, countdown and fit keep driving it;
    the "tv" tag tells HomeUiHelper.applyPrimaryCard to paint it (paintTvCard).

    The whole card is the button (connect, or back to Android Auto). Header: "Android Auto". Middle:
    the Android Auto logo in the grid panel with the status under it. Cancel shows only while a
    connection is on its way.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_primary_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/uiCardBg"
    android:tag="tv"
    android:foreground="?attr/uiCardPress"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="@string/tv_android_auto">

    <LinearLayout
        android:id="@+id/home_primary_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="10dp">

        <LinearLayout style="@style/SwCardHeader">

            <TextView
                android:id="@+id/tv_aa_label"
                style="@style/SwText.Header"
                android:text="@string/tv_android_auto" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/tv_aa_chip"
                style="@style/SwChip"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/tv_aa_chip_icon"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginRight="3dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_usb_white"
                    app:tint="?attr/uiTextSoft" />

                <TextView
                    android:id="@+id/home_primary_kicker"
                    style="@style/SwText.Chip" />

            </LinearLayout>

        </LinearLayout>

        <!-- The grid panel; HomeUiHelper.paintTvCard gives it its ScopeDrawable -->
        <LinearLayout
            android:id="@+id/tv_aa_scope"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp">

            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp">

                <!-- A soft cyan glow behind the logo -->
                <View
                    android:id="@+id/tv_aa_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="?attr/uiLogoGlow" />

                <!-- Breathes out while a phone is projecting -->
                <View
                    android:id="@+id/tv_aa_pulse"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="6dp"
                    android:background="?attr/uiAvatarRing"
                    android:visibility="invisible" />

                <FrameLayout
                    android:id="@+id/tv_aa_disc"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/tv_aa_icon"
                        android:layout_width="118dp"
                        android:layout_height="118dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:srcCompat="@drawable/sw_ic_android_auto"
                        app:tint="?attr/uiIconIdle" />

                    <TextView
                        android:id="@+id/home_countdown"
                        style="@style/SwText.Clock"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="?attr/uiHighlight"
                        android:textSize="64sp"
                        android:visibility="gone" />

                </FrameLayout>

            </FrameLayout>

            <TextView
                android:id="@+id/home_primary_title"
                style="@style/SwText.Big"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/tv_white"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/home_primary_subtitle"
                style="@style/SwText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="?attr/uiTextIce"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/home_primary_detail"
                style="@style/SwText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/home_primary_progress"
                android:layout_width="180dp"
                android:layout_height="5dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:importantForAccessibility="no"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/home_primary_progress_fill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <View
                        android:id="@+id/home_primary_progress_shine"
                        android:layout_width="@dimen/home_progress_shine_width"
                        android:layout_height="match_parent" />

                </FrameLayout>

                <View
                    android:id="@+id/home_primary_progress_rest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_primary_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/home_primary_action"
                style="@style/SwButton"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:includeFontPadding="false"
                android:textColor="@color/tv_white"
                android:textSize="15sp"
                android:shadowColor="?attr/uiShadow"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1" />

            <TextView
                android:id="@+id/home_primary_cancel"
                style="@style/SwButton.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="8dp"
                android:background="?attr/uiBtnBg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:text="@string/cancel"
                android:textSize="17sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Painted and hidden by the shared helpers; this card shows its own logo. Kept so those
         helpers find what they look for. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <FrameLayout
            android:id="@+id/home_primary_icon_tile"
            android:layout_width="0dp"
            android:layout_height="0dp">
            <ImageView
                android:id="@+id/home_primary_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>

</FrameLayout>
