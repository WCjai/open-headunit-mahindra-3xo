<?xml version="1.0" encoding="utf-8"?>
<!-- Bento home tile: frosted glass over the wallpaper. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bento_glass_pressed" />
            <stroke android:width="1dp" android:color="@color/bento_glass_edge" />
            <corners android:radius="@dimen/bento_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bento_glass_pressed" />
            <stroke android:width="3dp" android:color="@color/bento_text" />
            <corners android:radius="@dimen/bento_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bento_glass" />
            <stroke android:width="1dp" android:color="@color/bento_glass_edge" />
            <corners android:radius="@dimen/bento_radius" />
        </shape>
    </item>
</selector>
