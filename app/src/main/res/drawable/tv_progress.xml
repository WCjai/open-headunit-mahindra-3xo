<?xml version="1.0" encoding="utf-8"?>
<!-- The song's progress on Now Playing: a white bar on a faint track. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle"><solid android:color="@color/tv_white_20" /><corners android:radius="3dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape android:shape="rectangle"><solid android:color="@color/tv_white" /><corners android:radius="3dp" /></shape></clip>
    </item>
</layer-list>
