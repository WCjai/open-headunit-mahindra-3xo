<?xml version="1.0" encoding="utf-8"?>
<!-- One option of a segmented control: white when chosen, glass otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="@color/bento_text" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/bento_glass_strong" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bento_glass_pressed" />
            <stroke android:width="2dp" android:color="@color/bento_text" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bento_glass" />
            <stroke android:width="1dp" android:color="@color/bento_glass_edge" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
