<?xml version="1.0" encoding="utf-8"?>
<!-- tvOS glass card: white at 6% over the ambient colours, a hairline edge, big corners. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape android:shape="rectangle"><solid android:color="@color/tv_glass_focus" /><stroke android:width="2dp" android:color="@color/tv_white_70" /><corners android:radius="@dimen/tv_card_radius" /></shape></item>
    <item><shape android:shape="rectangle"><solid android:color="@color/tv_glass" /><stroke android:width="1dp" android:color="@color/tv_glass_edge" /><corners android:radius="@dimen/tv_card_radius" /></shape></item>
</selector>
