<?xml version="1.0" encoding="utf-8"?>
<!--
    The App Library on the tvOS home: every app as a glass tile over the home's light, Home on the
    left. Same ids as fragment_app_drawer for the list, the spinner and the empty text.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.andrerinas.openheadunit.main.bento.TvAmbientView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/tv_veil" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="14dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="34dp"
            android:layout_marginRight="34dp">

            <LinearLayout
                android:id="@+id/tv_drawer_back"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center_vertical|left"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingRight="18dp"
                android:background="@drawable/tv_glass_btn_bg"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/tv_back_to_home">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/tv_ic_chevron_left" />

                <TextView
                    style="@style/TvText"
                    android:layout_marginLeft="6dp"
                    android:text="@string/tv_home"
                    android:textSize="16sp"
                    android:fontFamily="@font/inter_medium" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_drawer_title"
                style="@style/TvText.Kicker"
                android:layout_gravity="center"
                android:text="@string/tv_app_library" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_apps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingLeft="31dp"
                android:paddingRight="31dp"
                android:paddingTop="10dp"
                android:paddingBottom="16dp"
                tools:listitem="@layout/item_app_drawer_tv" />

            <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_empty"
                style="@style/TvText"
                android:layout_gravity="center"
                android:text="@string/no_apps_found"
                android:textColor="@color/tv_white_70"
                android:textSize="16sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
