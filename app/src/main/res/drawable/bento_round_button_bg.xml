<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="@color/bento_glass_strong" /></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/bento_glass_strong" />
            <stroke android:width="2dp" android:color="@color/bento_text" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="@color/bento_glass_pressed" /></shape>
    </item>
</selector>
