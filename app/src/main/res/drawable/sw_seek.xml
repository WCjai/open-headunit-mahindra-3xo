<?xml version="1.0" encoding="utf-8"?>
<!-- The Sound screen's sliders: a dark slot filling cyan, like Now Playing's song position -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="8dp">
        <shape><corners android:radius="4dp" /><solid android:color="#FF120A1E" /><stroke android:width="1dp" android:color="#995B2F6E" /></shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="8dp">
        <clip><shape><corners android:radius="4dp" /><solid android:color="#FF2DE2E6" /></shape></clip>
    </item>
</layer-list>
