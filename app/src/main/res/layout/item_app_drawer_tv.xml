<?xml version="1.0" encoding="utf-8"?>
<!-- One app in the tvOS App Library: its own icon on a glass tile, the name under it. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="158dp"
    android:padding="9dp">

    <LinearLayout
        android:id="@+id/tv_app_tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/tv_card_bg"
        android:duplicateParentState="true"
        android:padding="10dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@null"
                tools:src="@mipmap/ic_launcher" />

            <ImageView
                android:id="@+id/iv_shortcut_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:contentDescription="@string/home_shortcut_badge"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_shortcut_badge" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_app_name"
            style="@style/TvText"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="15sp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/tv_white_90"
            tools:text="App Name" />

    </LinearLayout>

</FrameLayout>
